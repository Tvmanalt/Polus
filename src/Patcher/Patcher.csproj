<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Polus</AssemblyName>
    <RootNamespace>Polus.Patcher</RootNamespace>
    <ApplicationIcon>polus.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="polus.ico" CopyToOutputDirectory="PreserveNewest" />
  </PropertyGroup>
</Project>
